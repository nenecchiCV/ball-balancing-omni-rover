{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug STM32 (OpenOCD)",
      "type": "cortex-debug",
      "request": "launch",
      "servertype": "openocd",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/build-zephyr/zephyr/zephyr.elf",
      "configFiles": [
        "interface/stlink.cfg",
        "target/stm32g4x.cfg"
      ],
      "runToEntryPoint": "main",
      "showDevDebugOutput": "raw",
      "preLaunchTask": "build"
    },
    {
      "name": "Attach STM32 (OpenOCD)",
      "type": "cortex-debug",
      "request": "attach",
      "servertype": "openocd",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/build-zephyr/zephyr/zephyr.elf",
      "configFiles": [
        "interface/stlink.cfg",
        "target/stm32g4x.cfg"
      ]
    },
    {
      "name": "Debug STM32 (host OpenOCD)",
      "type": "cortex-debug",
      "request": "launch",
      "servertype": "external",
      "gdbTarget": "host.docker.internal:3333",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/build-zephyr/zephyr/zephyr.elf",
      "runToEntryPoint": "main",
      "showDevDebugOutput": "raw",
      "preLaunchTask": "build"
    },
    {
      "name": "Attach STM32 (host OpenOCD)",
      "type": "cortex-debug",
      "request": "attach",
      "servertype": "external",
      "gdbTarget": "host.docker.internal:3333",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/build-zephyr/zephyr/zephyr.elf"
    }
  ]
}
