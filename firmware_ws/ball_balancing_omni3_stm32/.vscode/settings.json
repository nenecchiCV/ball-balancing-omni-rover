{
  "C_Cpp.default.compileCommands": "${workspaceFolder}/build-zephyr/compile_commands.json",
  "C_Cpp.default.cStandard": "c11",
  "C_Cpp.default.cppStandard": "c++23",
  "files.associations": {
    "*.hpp": "cpp",
    "array": "cpp",
    "cmath": "cpp"
  },
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd",
  "clangd.path": "clangd",
  "clangd.arguments": [
    "--compile-commands-dir=${workspaceFolder}/build-zephyr-tidy",
    "--completion-style=detailed",
    "--header-insertion=never"
  ],
  "cmake.configureArgs": [
    "-DBOARD=nucleo_g474re",
    "-DCMAKE_BUILD_TYPE=Debug"
  ],
  "cmake.generator": "Ninja"
}
