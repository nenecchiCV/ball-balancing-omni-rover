{
  "C_Cpp.default.compileCommands": "${workspaceFolder}/build-zephyr/compile_commands.json",
  "C_Cpp.default.cStandard": "c11",
  "C_Cpp.default.cppStandard": "c++23",
  "files.associations": {
    "*.hpp": "cpp",
    "array": "cpp",
    "cmath": "cpp"
  },
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd",
  "clangd.path": "clangd",
  "clangd.arguments": [
    "--compile-commands-dir=${workspaceFolder}/build-zephyr-tidy",
    "--completion-style=detailed",
    "--header-insertion=never"
  ],
  "cmake.configureArgs": [
    "-DBOARD=nucleo_g474re",
    "-DCMAKE_BUILD_TYPE=Debug"
  ],
  "cmake.generator": "Ninja",
  "terminal.integrated.env.windows": {
    "ZEPHYR_TOOLCHAIN_VARIANT": "zephyr",
    "ZEPHYR_SDK_INSTALL_DIR": "C:/tools/zephyr-sdk-0.17.4"
  },
  "terminal.integrated.env.osx": {
    "PATH": "${env:HOME}/zephyr_ws/.venv/bin:${env:PATH}",
    "ZEPHYR_TOOLCHAIN_VARIANT": "zephyr",
    "ZEPHYR_SDK_INSTALL_DIR": "${env:HOME}/zephyr-sdk-0.17.4",
    "ZEPHYR_WS_DIR": "${env:HOME}/zephyr_ws",
    "IPHONEOS_DEPLOYMENT_TARGET": null
  }
}
