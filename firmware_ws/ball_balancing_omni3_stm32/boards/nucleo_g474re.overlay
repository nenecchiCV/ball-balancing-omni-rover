/*
 * Ball-balancing robot on NUCLEO-G474RE
 * ピン割当の正本は spec/requirements/hardware_config.md
 */

#include <zephyr/dt-bindings/pwm/pwm.h>
#include <zephyr/dt-bindings/pwm/stm32_pwm.h>
#include <zephyr/dt-bindings/sensor/lsm6dso.h>

/ {
	aliases {
		imu0 = &lsm6dso;
		pwm-m0 = &pwm17;
		pwm-m1 = &pwm16;
		pwm-m2 = &pwm4;
		qdec0 = &qdec0;
		qdec1 = &qdec1;
		qdec2 = &qdec2;
		control-tick = &timers6;
	};

	bb_pins: bb-pins {
		compatible = "bb,pins";
		led-gpios = <&gpioa 5 GPIO_ACTIVE_HIGH>;
		estop-gpios = <&gpioc 0 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
		estop-btn-gpios = <&gpioc 13 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
		/* motor PWM: 20 kHz キャリア。
		 * MDD3A は CW/CCW 2入力のため MxA/MxB とも PWM とし、
		 * MxA(正転脚)/MxB(逆転脚) をモーターごとに交互に並べる。
		 * M0B は TIM8_CH1N のため COMPLEMENTARY フラグが必要。 */
		pwms = <&pwm17 1 PWM_KHZ(20) PWM_POLARITY_NORMAL>,
		       <&pwm8 1 PWM_KHZ(20) (PWM_POLARITY_NORMAL | STM32_PWM_COMPLEMENTARY)>,
		       <&pwm16 1 PWM_KHZ(20) PWM_POLARITY_NORMAL>,
		       <&pwm15 1 PWM_KHZ(20) PWM_POLARITY_NORMAL>,
		       <&pwm4 1 PWM_KHZ(20) PWM_POLARITY_NORMAL>,
		       <&pwm8 2 PWM_KHZ(20) PWM_POLARITY_NORMAL>;
	};
};

/* ボード標準 dts がデフォルト有効化しているノードのうち、
 * 本機のモーター/エンコーダ/LED ピンを奪うものを無効化する。
 * pwm3: PB4(M1A) を TIM3_CH1 として確保 → TIM16_CH1 と二重設定になる
 * pwm2: PA5(LD2) を TIM2_CH1 として確保
 * spi1: PA5/PA6/PA7(LD2, ENC2) と CS=PB6(M2A) を確保
 * spi2: PB14(M1B) を含むピンを確保
 * adc1: PA0(ENC0) をアナログ入力として確保 */
&pwm2 {
	status = "disabled";
};

&pwm3 {
	status = "disabled";
};

&spi1 {
	status = "disabled";
};

&spi2 {
	status = "disabled";
};

&adc1 {
	status = "disabled";
};

/* IMU: LSM6DSO on I2C1 (PB8/PB9) */
&i2c1 {
	pinctrl-0 = <&i2c1_scl_pb8 &i2c1_sda_pb9>;
	pinctrl-names = "default";
	status = "okay";

	lsm6dso: lsm6dso@6b {
		compatible = "st,lsm6dso";
		reg = <0x6b>;
		status = "okay";
		accel-range = <LSM6DSO_DT_FS_4G>;
		accel-odr = <LSM6DSO_DT_ODR_833Hz>;
		gyro-range = <LSM6DSO_DT_FS_2000DPS>;
		gyro-odr = <LSM6DSO_DT_ODR_833Hz>;
	};
};

/* Wheel encoders (qdec childでエンコーダモード設定。
 * counts-per-revolution は 2 の累乗にし、ARR=65535 の16bit自由周回とする) */
&timers2 {
	status = "okay";
	st,prescaler = <0>;

	qdec0: qdec {
		compatible = "st,stm32-qdec";
		status = "okay";
		pinctrl-0 = <&tim2_ch1_pa0 &tim2_ch2_pa1>;
		pinctrl-names = "default";
		st,encoder-mode = <3>;
		st,counts-per-revolution = <16384>;
		st,input-filter-level = <0>;
	};
};

&timers3 {
	status = "okay";
	st,prescaler = <0>;

	qdec2: qdec {
		compatible = "st,stm32-qdec";
		status = "okay";
		pinctrl-0 = <&tim3_ch1_pa6 &tim3_ch2_pa7>;
		pinctrl-names = "default";
		st,encoder-mode = <3>;
		st,counts-per-revolution = <16384>;
		st,input-filter-level = <0>;
	};
};

&timers1 {
	status = "okay";
	st,prescaler = <0>;

	qdec1: qdec {
		compatible = "st,stm32-qdec";
		status = "okay";
		pinctrl-0 = <&tim1_ch1_pa8 &tim1_ch2_pa9>;
		pinctrl-names = "default";
		st,encoder-mode = <3>;
		st,counts-per-revolution = <16384>;
		st,input-filter-level = <0>;
	};
};

/* Motor PWM: MxA=TIM17/16/4、MxB=TIM8(CH1N/CH2)+TIM15
 * M0A=TIM17_CH1/PB5(D4)  M0B=TIM8_CH1N/PB3(D3)
 * M1A=TIM16_CH1/PB4(D5)  M1B=TIM15_CH1/PB14(モルフォ CN10-28)
 * M2A=TIM4_CH1/PB6(D10)  M2B=TIM8_CH2/PC7(D9) */
&timers8 {
	status = "okay";
	st,prescaler = <0>;

	pwm8: pwm {
		status = "okay";
		pinctrl-0 = <&tim8_ch1n_pb3 &tim8_ch2_pc7>;
		pinctrl-names = "default";
	};
};

&timers15 {
	status = "okay";
	st,prescaler = <0>;

	pwm15: pwm {
		status = "okay";
		pinctrl-0 = <&tim15_ch1_pb14>;
		pinctrl-names = "default";
	};
};

&timers16 {
	status = "okay";
	st,prescaler = <0>;

	pwm16: pwm {
		status = "okay";
		pinctrl-0 = <&tim16_ch1_pb4>;
		pinctrl-names = "default";
	};
};

&timers17 {
	status = "okay";
	st,prescaler = <0>;

	pwm17: pwm {
		status = "okay";
		pinctrl-0 = <&tim17_ch1_pb5>;
		pinctrl-names = "default";
	};
};

&timers4 {
	status = "okay";
	st,prescaler = <0>;

	pwm4: pwm {
		status = "okay";
		pinctrl-0 = <&tim4_ch1_pb6>;
		pinctrl-names = "default";
	};
};

/* 1 kHz 制御ティック（ドライバ不使用、IRQ_CONNECTで占有） */
&timers6 {
	status = "okay";
	st,prescaler = <169>; /* 170 MHz / 170 = 1 MHz カウント */
};
