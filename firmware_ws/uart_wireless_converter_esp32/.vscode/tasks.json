{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "configure",
      "type": "shell",
      "command": "cmake",
      "args": [
        "-S", ".",
        "-B", "build-zephyr",
        "-G", "Ninja",
        "-DBOARD=xiao_esp32c6/esp32c6/hpcore",
        "-DCMAKE_BUILD_TYPE=Debug",
        "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON"
      ],
      "problemMatcher": []
    },
    {
      "label": "build",
      "type": "shell",
      "command": "cmake",
      "args": ["--build", "build-zephyr"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "lint",
      "type": "shell",
      "command": "cmake",
      "args": [
        "-DCLANG_TIDY=clang-tidy",
        "-DCOMPILE_COMMANDS=build-zephyr/compile_commands.json",
        "-DSRC_ROOT=uart_wireless_converter_esp32/src",
        "-P", "cmake/run_clang_tidy.cmake"
      ],
      "problemMatcher": []
    },
    {
      "label": "format-check",
      "type": "shell",
      "command": "cmake",
      "args": [
        "-DCLANG_FORMAT=clang-format",
        "-DSRC_ROOT=${workspaceFolder}/src",
        "-DTEST_ROOT=${workspaceFolder}/tests/host/src",
        "-P", "cmake/run_clang_format.cmake"
      ],
      "problemMatcher": []
    },
    {
      "label": "flash",
      "type": "shell",
      "command": "esptool",
      "args": [
        "--chip", "esp32c6",
        "write_flash",
        "0x0",
        "build-zephyr/zephyr.bin"
      ],
      "dependsOn": ["build"],
      "problemMatcher": []
    }
  ]
}
